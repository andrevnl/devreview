{
  "name": "devreview-mcp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "devreview-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file=.env build/index.js",
    "test": "npm run build && node --test \"build/**/*.test.js\"",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector@2.9.0 --config inspector.config.json",
    "inspector:cli": "npm run build && npx -y @modelcontextprotocol/inspector@2.9.0 --cli --config inspector.config.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.49.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.6.3"
  }
}
